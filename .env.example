# Copy this file to .env.local and fill in the values you use.
# .env.local is ignored by git, so keys never end up on GitHub.
# Restart `npm run dev` after changing it.

# Google Maps Platform key with the Solar API and Geocoding API enabled (Instant Quote drawer).
# Visitors' browsers can see it, so restrict it to your domain (HTTP referrers) in Google Cloud Console.
# Leave empty to run the Instant Quote in demo mode with sample measurements.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# URL that receives Instant Quote leads as JSON (CRM webhook, form service, etc.).
NEXT_PUBLIC_LEAD_ENDPOINT=

# AI provider for the Roof Assistant chat (app/api/chat/route.js), via OpenRouter (openrouter.ai — free
# account, free-tier models available). Get a key at https://openrouter.ai/keys. Leave empty to use the
# built-in canned answers in data/assistant.js instead.
OPENROUTER_API_KEY=

# OpenRouter model id for the chat assistant. Double-check the exact slug at https://openrouter.ai/models
# before going live — free-tier model names change over time.
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Where the Roof Assistant sends leads it captures from the conversation (name, phone, email, zip, interest
# and transcript) as JSON — point this at your CRM's webhook once you have one (lib/crm.js). Leave empty to
# just log captured leads to the server console for now.
CRM_LEAD_ENDPOINT=

# Bearer token sent with CRM_LEAD_ENDPOINT requests, if your CRM requires one.
CRM_LEAD_TOKEN=

# Only set this to point the Roof Assistant widget at a different, separately hosted chat backend instead of
# the built-in app/api/chat/route.js. It receives POST {messages:[{role,content}]}, returns {reply:"..."}.
NEXT_PUBLIC_CHAT_ENDPOINT=

# Local testing only: pretend the visitor's IP address is at this "latitude,longitude" so the service area map
# shows its nearest-location suggestion (on the live site the location comes from Cloudflare or Vercel).
# DEV_IP_LOCATION=34.1425,-118.2551
